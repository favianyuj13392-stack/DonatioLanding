---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProductPreview from '../components/ProductPreview.tsx';
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  CreditCard,
  Heart,
  Layers,
  LayoutDashboard,
  Menu,
  Plus,
  Repeat,
} from 'lucide-react';

const faqs = [
  {
    question: '¿Donatio es una página para donar o una plataforma de gestión?',
    answer: 'Ambas cosas, conectadas. Tu organización puede presentar su misión y sus campañas en una página con identidad propia, recibir aportes y administrar campañas, transacciones, socios recurrentes y liquidaciones desde su panel.'
  },
  {
    question: '¿La experiencia puede llevar la marca de mi organización?',
    answer: 'Sí. Donatio contempla páginas institucionales y de campañas con la identidad de cada organización: su logo, sus colores y su contenido. La vista de ejemplo de esta página permite explorar distintas paletas; no modifica una organización real.'
  },
  {
    question: '¿Se pueden recibir aportes recurrentes?',
    answer: 'Sí. La plataforma contempla aportes únicos y recurrentes. La recurrencia automática depende del medio de pago habilitado: un pago por QR no genera cobros mensuales automáticos.'
  },
  {
    question: '¿Qué monedas contempla la plataforma?',
    answer: 'Donatio contempla bolivianos (BOB) y dólares estadounidenses (USD). Las modalidades de cobro disponibles dependen de la configuración de cada organización.'
  },
];

const proofItems = [
  { icon: Heart, title: 'Tu marca', detail: 'Una experiencia propia' },
  { icon: CreditCard, title: 'BOB + USD', detail: 'Dos monedas, una plataforma' },
  { icon: Repeat, title: 'Aportes recurrentes', detail: 'Vínculos que continúan' },
  { icon: LayoutDashboard, title: 'Control centralizado', detail: 'Una gestión más clara' }
];

const steps = [
  { number: '01', title: 'Haz visible tu causa', text: 'Presenta tu organización con su identidad y da a cada campaña un espacio para contar su propósito.' },
  { number: '02', title: 'Conecta con el apoyo', text: 'Reúne aportes para campañas específicas o para la misión general, con opciones únicas y recurrentes.' },
  { number: '03', title: 'Acompaña lo que sigue', text: 'Consulta tus transacciones, administra tus campañas y da seguimiento a tus socios desde el panel.' }
];

const roles = [
  { number: '01', title: 'Dirección', text: 'La identidad de la organización y sus campañas, reunidas en una experiencia coherente.' },
  { number: '02', title: 'Captación de fondos', text: 'Un lugar para presentar cada causa y ofrecer distintas formas de acompañarla.' },
  { number: '03', title: 'Administración', text: 'Transacciones, socios recurrentes y liquidaciones organizados para su seguimiento.' }
];
---

<Layout>
  <div class="dm-page" id="dm-top">
    <a class="dm-skip-link" href="#dm-main">Saltar al contenido</a>
    <header class="dm-header">
      <div class="dm-container dm-header-inner">
        <a class="dm-brand" href="#dm-top" aria-label="Donatio, inicio">
          <span class="dm-brand-mark" aria-hidden="true">
            <img src="/brand/donatio-logo.png" alt="Logo Donatio" width="1254" height="1254" />
          </span>
          <span>Donatio<span class="dm-brand-dot">.</span></span>
        </a>
        <button class="dm-menu-toggle" id="dm-menu-toggle" type="button" aria-expanded="false" aria-controls="dm-navigation" aria-label="Abrir menú">
          <Menu size={23} aria-hidden="true" />
        </button>
        <nav id="dm-navigation" class="dm-navigation" aria-label="Navegación principal">
          <a href="#dm-producto">La plataforma</a>
          <a href="#dm-como-funciona">Cómo funciona</a>
          <a href="#dm-para-quien">Para tu organización</a>
          <a class="dm-nav-cta" href="#dm-producto">Explorar Donatio <ArrowUpRight size={16} aria-hidden="true" /></a>
        </nav>
      </div>
    </header>

    <main id="dm-main" tabindex="-1">
      <section class="dm-hero" aria-labelledby="dm-hero-title">
        <div class="dm-container dm-hero-grid">
          <div class="dm-hero-copy">
            <p class="dm-eyebrow"><span />TECNOLOGÍA CON PROPÓSITO</p>
            <h1 id="dm-hero-title">Tu causa,<br />con más<br /><em>futuro.</em></h1>
            <p class="dm-hero-description">Conecta a quienes quieren ayudar con todo lo que tu organización puede hacer.</p>
            <p class="dm-hero-detail">Tu marca, tus campañas y la gestión de tus aportes. Una plataforma para que la misión esté siempre al frente.</p>
            <div class="dm-hero-actions">
              <a class="dm-button dm-button-primary" href="#dm-producto">Conocer la plataforma <ArrowUpRight size={18} aria-hidden="true" /></a>
              <a class="dm-text-link" href="#dm-como-funciona">Cómo funciona <ArrowRight size={17} aria-hidden="true" /></a>
            </div>
            <div class="dm-hero-signoff"><span class="dm-signoff-line" /><span>Conecta causas. Cambia vidas.</span></div>
          </div>
          <ProductPreview client:visible />
        </div>
        <div class="dm-container">
          <div class="dm-proof-strip">
            {proofItems.map(({ icon: Icon, title, detail }) => (
              <div>
                <Icon size={20} strokeWidth={1.5} aria-hidden="true" />
                <p><strong>{title}</strong><span>{detail}</span></p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="dm-section dm-platform" aria-labelledby="dm-platform-title">
        <div class="dm-container">
          <div class="dm-section-heading">
            <div>
              <p class="dm-eyebrow">01 — UNA MISIÓN, TODO CONECTADO</p>
              <h2 id="dm-platform-title">Menos dispersión.<br />Más <em>propósito.</em></h2>
            </div>
            <p>Una buena causa necesita ser contada.<br />Y también necesita herramientas para sostenerse.</p>
          </div>
          <div class="dm-feature-grid">
            <article class="dm-feature dm-feature-brand">
              <span class="dm-feature-number">01 / IDENTIDAD</span>
              <h3>Tu marca,<br />al frente.</h3>
              <p>Una página para contar quiénes son, presentar sus campañas y recibir aportes sin perder su identidad.</p>
              <div class="dm-brand-example" aria-label="Ejemplo ilustrativo de identidad institucional">
                <span><Heart size={17} aria-hidden="true" /> TU ORGANIZACIÓN</span>
                <strong>Hay historias que<br />podemos cambiar.</strong>
                <div><span>Tu historia</span><span>Tu comunidad</span><span>Tu causa</span></div>
              </div>
              <span class="dm-feature-bottom">Páginas institucionales y de campañas <ArrowUpRight size={18} aria-hidden="true" /></span>
            </article>
            <article class="dm-feature dm-feature-recurring">
              <div class="dm-feature-top">
                <span class="dm-feature-number">02 / CONTINUIDAD</span>
                <Repeat size={25} strokeWidth={1.4} aria-hidden="true" />
              </div>
              <h3>Que el apoyo<br />no termine hoy.</h3>
              <p>Aportes únicos para una necesidad concreta. Socios recurrentes para acompañar una misión en el tiempo.</p>
              <div class="dm-frequency-example" aria-label="Modalidades de aporte">
                <span>Una vez</span>
                <span><Check size={14} aria-hidden="true" /> Mes a mes</span>
              </div>
            </article>
            <article class="dm-feature dm-feature-control">
              <div class="dm-feature-top">
                <span class="dm-feature-number">03 / GESTIÓN</span>
                <Layers size={25} strokeWidth={1.4} aria-hidden="true" />
              </div>
              <h3>La información,<br />en su lugar.</h3>
              <p>Campañas, transacciones, socios y liquidaciones. Un panel para seguir lo que pasa y trabajar con claridad.</p>
              <div class="dm-control-example">
                <span><Check size={13} aria-hidden="true" /> Campañas</span>
                <span><Check size={13} aria-hidden="true" /> Aportes</span>
                <span><Check size={13} aria-hidden="true" /> Socios</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="dm-section dm-process" id="dm-como-funciona" aria-labelledby="dm-process-title">
        <div class="dm-container">
          <div class="dm-section-heading">
            <div>
              <p class="dm-eyebrow">02 — DE LA MISIÓN A LA ACCIÓN</p>
              <h2 id="dm-process-title">Un camino claro.<br />Un impacto <em>compartido.</em></h2>
            </div>
            <a class="dm-text-link" href="#dm-producto">Explorar la vista de producto <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
          <ol class="dm-steps">
            {steps.map((step) => (
              <li>
                <div><span>{step.number}</span><ArrowRight size={22} strokeWidth={1.3} aria-hidden="true" /></div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="dm-section dm-audience" id="dm-para-quien" aria-labelledby="dm-audience-title">
        <div class="dm-container dm-audience-grid">
          <div>
            <p class="dm-eyebrow">03 — PARA QUIENES ESTÁN AL FRENTE</p>
            <h2 id="dm-audience-title">La misión es grande.<br />Tu equipo no tiene<br />que hacerlo <em>todo solo.</em></h2>
            <p class="dm-audience-lead">Para fundaciones y organizaciones sin fines de lucro que quieren conectar su propósito con una gestión más clara.</p>
            <span class="dm-audience-note"><Heart size={17} aria-hidden="true" /> Tecnología al servicio de las personas.</span>
          </div>
          <div class="dm-roles">
            {roles.map((role) => (
              <article>
                <span>{role.number}</span>
                <div><h3>{role.title}</h3><p>{role.text}</p></div>
                <ArrowUpRight size={20} aria-hidden="true" />
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="dm-section dm-faq" aria-labelledby="dm-faq-title">
        <div class="dm-container dm-faq-grid">
          <div>
            <p class="dm-eyebrow">LO ESENCIAL, SIN LETRA PEQUEÑA</p>
            <h2 id="dm-faq-title">Buenas preguntas.<br /><em>Respuestas claras.</em></h2>
          </div>
          <div class="dm-faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>{faq.question}<Plus size={20} aria-hidden="true" /></summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="dm-closing" aria-labelledby="dm-closing-title">
        <div class="dm-container dm-closing-inner">
          <div>
            <p class="dm-eyebrow">EL PRÓXIMO CAPÍTULO EMPIEZA CON UNA CONEXIÓN</p>
            <h2 id="dm-closing-title">Detrás de tu causa,<br />hay un futuro <em>posible.</em></h2>
            <p>Dale a tu organización un espacio para conectar,<br />recibir apoyo y seguir adelante.</p>
            <a class="dm-button dm-button-light" href="#dm-producto">Explorar Donatio <ArrowUpRight size={19} aria-hidden="true" /></a>
          </div>
          <div class="dm-closing-statement" aria-hidden="true">
            <Heart size={48} strokeWidth={1} />
            <span>Conecta<br />causas.<br /><em>Cambia<br />vidas.</em></span>
          </div>
        </div>
      </section>
    </main>

    <footer class="dm-footer">
      <div class="dm-container dm-footer-inner">
        <a class="dm-brand dm-brand-light" href="#dm-top" aria-label="Donatio, inicio">
          <span class="dm-brand-mark" aria-hidden="true">
            <img src="/brand/donatio-logo.png" alt="Logo Donatio" width="1254" height="1254" />
          </span>
          <span>Donatio<span class="dm-brand-dot">.</span></span>
        </a>
        <p>Tecnología con propósito. Una plataforma creada por <a href="https://darkosync.com" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">DarkoSync</a>.</p>
        <a href="#dm-top">Volver al inicio <ArrowUpRight size={15} aria-hidden="true" /></a>
      </div>
    </footer>
  </div>

  <script>
    const toggle = document.getElementById('dm-menu-toggle');
    const nav = document.getElementById('dm-navigation');
    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('dm-navigation-open');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('dm-navigation-open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('dm-navigation-open')) {
          nav.classList.remove('dm-navigation-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });
    }
  </script>
</Layout>
